# ---------------------------------------------------------------------------
# Configuración de entorno (Vite)
# Copiar a `.env` y completar con los valores del proyecto Supabase.
# IMPORTANTE: `.env` está en .gitignore y NO debe commitearse.
#
# Sólo variables con prefijo VITE_ llegan al bundle del navegador.
# Ese bundle se publica en GitHub Pages: TODO lo que empiece con VITE_ es PÚBLICO.
# Por lo tanto aquí sólo va material público por diseño (publishable key).
#
# PROHIBIDO en este archivo y en cualquier archivo del frontend:
#   - SUPABASE_SERVICE_ROLE_KEY
#   - SUPABASE_SECRET_KEY
#   - JWT secrets
#   - tokens de WhatsApp/Telegram/Turnstile secret
# Los secretos van en Edge Functions / variables de entorno del servidor.
# ---------------------------------------------------------------------------

# URL del proyecto Supabase (pública)
VITE_SUPABASE_URL=

# Publishable key (pública por diseño, protegida por RLS).
# Formato nuevo: sb_publishable_...
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public site URL used to build shareable event links.
# En producción: https://<usuario>.github.io/rifas-y-sorteos
VITE_PUBLIC_APP_URL=

# Nombre de la aplicación mostrado en la UI (opcional)
VITE_APP_NAME=rifas-y-sorteos
# Subpath desde donde se sirve la app (el base de Vite).
#   - GitHub Pages sin dominio custom:  /rifas-y-sorteos/
#   - Con dominio custom o en dev:      /
VITE_BASE_PATH=
